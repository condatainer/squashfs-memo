Bootstrap: docker
From: ubuntu:24.04

# Everything build.sh needs to clone and compile fuse2fs, and nothing else —
# build-essential.def has git/gcc/make/pkg-config already but no libfuse3-dev.

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get -y update
    apt-get -y install \
        build-essential git pkg-config autoconf automake libtool \
        libfuse3-dev libblkid-dev uuid-dev texinfo fuse3
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec /bin/bash "$@"
