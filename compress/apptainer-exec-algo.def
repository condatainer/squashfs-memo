Bootstrap: docker
From: ubuntu:24.04

%post
	export DEBIAN_FRONTEND=noninteractive
	apt-get update
	apt-get install -y --no-install-recommends \
		python3 python3-pip ca-certificates \
		samtools \
		default-jdk
	# Ubuntu 24.04's system python3 is PEP 668 "externally managed"; pip
	# refuses to install into it without this flag.
	pip3 install --break-system-packages --no-cache-dir numpy pandas scikit-learn snakemake cutadapt==5.0
	apt-get clean
	rm -rf /var/lib/apt/lists/*
